# Run "python setup_env.py" to create .env with fresh secrets automatically.

# ---------- Login ----------
# Signs the login cookie. Long random string.
SESSION_SECRET=
SESSION_HOURS=8
# true only when served over HTTPS
COOKIE_SECURE=false

# Email + password accounts (stored hashed in data/users.json).
# Needed for the demo domain and for logging in from a phone on the local network.
LOCAL_LOGIN=true

# Optional: Google sign-in. Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=
# For domains in config/access.json, require a Google Workspace account of that
# domain. Emails listed one by one in "allowed_emails" are exempt.
REQUIRE_WORKSPACE_ACCOUNT=true

# ---------- Storage ----------
# Key used to encrypt uploaded documents on disk. Do not change it after
# uploading files, or old files can no longer be opened.
FILE_ENCRYPTION_KEY=
# Key rotation: when you make a new key, move the previous FILE_ENCRYPTION_KEY here
# (comma separated for several), then run: python rotate_keys.py
FILE_ENCRYPTION_KEYS_OLD=
MAX_UPLOAD_MB=15

# A manager must approve a checklist before the analyst can lock it
REQUIRE_APPROVAL=true

# Organisation name used in the consent script
ORG_NAME=Value Create

# ---------- Phase 2: recording the visit ----------
# Speech to text model: tiny, base, small (default, more accurate; about 480 MB). If a 10-second piece
# takes longer than 10 s to process on your laptop (see the Visit step), use base.
WHISPER_MODEL=small
# Language spoken in visits: en, hi ... Leave empty to auto-detect.
WHISPER_LANGUAGE=en
# Most picture checks sent to the AI per visit
CAPTURE_AI_BUDGET=80
# Block "Start visit" until speech to text is loaded and ready (recommended).
# Set to false only for a test without the speech model: pieces are then kept as "not analysed".
REQUIRE_SPEECH=true
# A spoken question counts as a planned checklist question only if it contains at least this share
# of that question's key words (0.6 = 60%; 0.75 = 9 of 12). Higher = stricter, but paraphrases are missed.
QUESTION_MATCH_MIN=0.6

# ---------- Optional AI (reading PDFs, and picture checks during visits) ----------
# Any OpenAI-compatible chat API. Example for Google Gemini:
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_MODEL=gemini-2.5-flash
# Most PDF pages sent to the AI per visit (pages are picked by keyword score)
LLM_MAX_PAGES=6
# Leave LLM_API_KEY empty: PDFs use the rule-based reader, and picture checks are skipped.
# The model must accept images for picture checks (gemini-2.5-flash does).
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash
